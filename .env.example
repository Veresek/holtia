# Use production on every public deployment. Production fails fast unless the
# SMTP block below and a strong SECRET_KEY are configured.
ENVIRONMENT=development

# Generate a unique random value of at least 32 characters for production.
SECRET_KEY=replace-with-a-long-random-secret

# Required by docker-compose.prod.yml. This instance uses holtia.xyz.
# Point DNS at the VPS before starting.
DOMAIN=holtia.xyz
# Use a generated alphanumeric value so it is safe in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-random-database-password

# Mail for verification and password-reset codes. docker-compose.prod.yml
# requires all of SMTP_HOST, SMTP_USER, SMTP_PASSWORD and MAIL_FROM, and the
# API refuses to start in production without them.
# Leave SMTP_HOST empty in development to send no email at all: registering
# verifies the account straight away, so local accounts need no mailbox. The
# development Compose stack sets none of these, so there accounts always skip
# verification; to exercise the codes, run the API outside Docker from server/
# with the values below in server/.env.
# SMTP_HOST is the mail server's own canonical hostname, e.g. mail.holtia.xyz,
# because the API verifies its TLS certificate during STARTTLS. An IP address
# or the app domain does not match that certificate.
# SMTP_USER and MAIL_FROM are the sending mailbox, e.g. holtia@holtia.xyz.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Optional. A code is valid for EMAIL_CODE_TTL_MINUTES and works once. Another
# code for the same address and purpose is only sent after
# EMAIL_CODE_COOLDOWN_SECONDS have elapsed since the last one.
# EMAIL_CODE_TTL_MINUTES=15
# EMAIL_CODE_COOLDOWN_SECONDS=60

TIMEZONE=Europe/Warsaw

# Used when running the API outside Docker. docker-compose.yml ignores this
# and talks to the db service as postgresql+psycopg://holtia:holtia@db:5432/holtia.
# docker-compose.prod.yml builds DATABASE_URL from POSTGRES_PASSWORD instead.
DATABASE_URL=postgresql+psycopg://holtia:holtia@localhost:5432/holtia

# Browser origin the API allows for cookie CORS. Dev compose sets
# http://localhost:5173. Prod compose sets https://${DOMAIN}; do not override
# that with http.
CLIENT_ORIGIN=http://localhost:5173

# Optional. Defaults: 10 requests / 60 seconds, enabled outside tests.
# AUTH_RATE_LIMIT_ENABLED=true
# AUTH_RATE_LIMIT_REQUESTS=10
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# AI assistant. Off by default. When enabled, AI_ENCRYPTION_KEY is required
# (32 bytes as standard base64 or 64 hex characters). Users bring their own
# OpenAI, Anthropic, Google Gemini, DeepSeek, or xAI key on Account.
# AI_ENABLED=false
# AI_ENCRYPTION_KEY=
# AI_REQUEST_TIMEOUT_SECONDS=30
# AI_PROMPT_MAX_LENGTH=2000
# AI_MAX_OUTPUT_TOKENS=2048
# AI_MAX_PROPOSALS=12
# AI_RATE_LIMIT_REQUESTS=20
# AI_RATE_LIMIT_WINDOW_SECONDS=3600
