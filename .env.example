# Use production on every public deployment. Production fails fast unless
# INSTANCE_CODE and a strong SECRET_KEY are configured.
ENVIRONMENT=development

# Leave empty only in development to skip account verification locally.
# In production this is an operator secret: anyone with the code and an
# account email can reset that password. Do not put it in the README.
# docker-compose.yml passes this through; docker-compose.prod.yml requires it.
INSTANCE_CODE=

# Generate a unique random value of at least 32 characters for production.
SECRET_KEY=replace-with-a-long-random-secret

# Required by docker-compose.prod.yml. Point DOMAIN at the VPS before starting.
DOMAIN=trium.example.com
# Use a generated alphanumeric value so it is safe in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-random-database-password

TIMEZONE=Europe/Warsaw

# Used when running the API outside Docker. docker-compose.yml ignores this
# and talks to the db service as postgresql+psycopg://trium:trium@db:5432/trium.
# docker-compose.prod.yml builds DATABASE_URL from POSTGRES_PASSWORD instead.
DATABASE_URL=postgresql+psycopg://trium:trium@localhost:5432/trium

# Browser origin the API allows for cookie CORS. Dev compose sets
# http://localhost:5173. Prod compose sets https://${DOMAIN}; do not override
# that with http.
CLIENT_ORIGIN=http://localhost:5173

# Optional. Defaults: 10 requests / 60 seconds, enabled outside tests.
# AUTH_RATE_LIMIT_ENABLED=true
# AUTH_RATE_LIMIT_REQUESTS=10
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# AI assistant. Off by default. When enabled, AI_ENCRYPTION_KEY is required
# (32 bytes as standard base64 or 64 hex characters). Users bring their own
# OpenAI, Anthropic, Google Gemini, DeepSeek, or xAI key on Account.
# AI_ENABLED=false
# AI_ENCRYPTION_KEY=
# AI_REQUEST_TIMEOUT_SECONDS=30
# AI_PROMPT_MAX_LENGTH=2000
# AI_MAX_OUTPUT_TOKENS=2048
# AI_MAX_PROPOSALS=12
# AI_RATE_LIMIT_REQUESTS=20
# AI_RATE_LIMIT_WINDOW_SECONDS=3600
